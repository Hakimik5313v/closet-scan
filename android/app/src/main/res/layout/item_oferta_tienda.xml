<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="165dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="#121218"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Imagen / Visualizador de la prenda de tienda -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#0A0A10">

        <ImageView
            android:id="@+id/imgOfertaTienda"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvIconoOfertaTienda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🧥"
            android:textSize="32sp" />
    </FrameLayout>

    <!-- Marca / Tienda -->
    <TextView
        android:id="@+id/tvNombreTienda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.04"
        android:text="Zara"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- Nombre de la Prenda -->
    <TextView
        android:id="@+id/tvPrendaOfertaTienda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Chaqueta bomber"
        android:textColor="#888899"
        android:textSize="11sp" />

    <!-- Precios y Descuento Noir -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPrecioTachado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$129.900"
            android:textColor="#666677"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/tvPrecioOferta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="$89.900"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvBadgeDescuento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="-31%"
            android:textColor="#000000"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botón 1: Ver en Tienda Oficial (Web Externa) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerEnTiendaWeb"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#1A1A24"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:text="Ver en Tienda ↗"
        android:textColor="#CCCCCC"
        android:textSize="9sp" />

    <!-- Botón 2: Probar en Vestier -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProbarOfertaEnVestier"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#FFFFFF"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.02"
        android:text="Probar en Vestier"
        android:textColor="#000000"
        android:textSize="9sp" />

</LinearLayout>
