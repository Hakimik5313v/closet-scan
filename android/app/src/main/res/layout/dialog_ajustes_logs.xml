<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F0F14"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:text="CONSOLA DE LOGS &amp; ERRORES IA"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnCerrarLogsDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#1B1B24"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#222230" />

    <!-- Barra de acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvEstadoConexionLogs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="● Registro activo"
            android:textColor="#80FF80"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnCopiarLogsModal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:background="#1B1B24"
            android:text="📋 COPIAR"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/btnLimpiarLogsModal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:background="#1B1B24"
            android:text="🗑️ LIMPIAR"
            android:textColor="#FF6B6B"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Caja de terminal -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="10dp"
        android:background="#07070A"
        android:padding="10dp">

        <ScrollView
            android:id="@+id/scrollLogsModal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvTerminalLogsModal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#80FF80"
                android:textSize="10.5sp"
                android:lineSpacingExtra="3dp"
                android:text="[Iniciando consola...]" />
        </ScrollView>
    </FrameLayout>

</LinearLayout>
